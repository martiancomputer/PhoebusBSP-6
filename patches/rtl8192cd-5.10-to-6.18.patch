+
+# --- PHOEBUS 6.18 port -------------------------------------------------------
+# Remaining warnings are INTERNAL to this vendor tree (its own HAL calling its
+# own HAL) between same-width typedefs -- BOOLEAN/u1Byte/u2Byte vs unsigned
+# char/short/int, and pointer<->integer on a 32-bit target. GCC 14 promotes them
+# to errors; older toolchains did not, and this code has shipped for years.
+#
+# NOTE the deliberate distinction from the g6 driver: there, suppressing
+# -Wincompatible-pointer-types hid *kernel ABI* mismatches (cfg80211_ops), which
+# the kernel calls with its own argument layout -> guaranteed crash. Here the
+# kernel-facing ABI is fixed properly (rtk_shim_* for cfg80211_ops, and the
+# notifier_call return type), so what remains is intra-driver only, where the
+# compiler can see both sides of every call.
+ccflags-y += -Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
+             -Wno-error=missing-prototypes -Wno-error=implicit-function-declaration \
+             -Wno-error=enum-conversion -Wno-error=enum-int-mismatch \
+             -Wno-error=implicit-fallthrough -Wno-error=empty-body \
+             -Wno-error=old-style-declaration -Wno-error=address \
+             -Wno-error=unused-result -Wno-error=discarded-qualifiers \
+             -Wno-error=sign-compare -Wno-error=unused-but-set-variable \
+             -Wno-error=unused-variable -Wno-error=maybe-uninitialized \
+             -Wno-error=stringop-overflow -Wno-error=array-bounds \
+             -Wno-error=misleading-indentation -Wno-error=restrict \
+             -Wno-error=unused-function -Wno-error=return-type
+
+# --- PHOEBUS symbol namespacing ------------------------------------------
+# g6_wifi_driver (5GHz RTL8832BR) and this driver (2.4GHz RTL8192F) are two
+# vendor forks that carry copies of the SAME shared Realtek code -- halrf_*,
+# sha256, and some cfg80211/ieee80211 helpers -- with identical global symbol
+# names. Built into one kernel they collide at link (50 duplicate definitions).
+# Rename this driver's copies at compile time so the g6 driver (already working
+# and HW-tested) keeps the canonical names. Definitions and all uses live inside
+# this driver, so a -D rename is consistent; nothing here is shared with the
+# kernel or with g6 by design.
+ccflags-y += -D_atoi=rtl8192cd__atoi
+ccflags-y += -Dcheck_pkt_type=rtl8192cd_check_pkt_type
