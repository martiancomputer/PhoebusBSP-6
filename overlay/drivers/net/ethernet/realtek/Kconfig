config RTL_FBM_STACKING_RECYCLE_SKB
	default n
	bool "Recycled skb support FBM"
	depends on RTL_ETH_RECYCLED_SKB && !RTL_ETH_RECYCLED_SKB_DEBUG
	help
	  This turns on FBM support which need hardware feature.
	  By enable this, the NIC driver should upgrade to the nwer version
	  which do not refill QM when receive packets from hardware.

	  If you do not have such feature, say 'N' here.

